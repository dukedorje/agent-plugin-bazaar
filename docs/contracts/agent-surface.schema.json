{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dukedorje/agent-plugin-bazaar/docs/contracts/agent-surface.schema.json",
  "title": "Agent surface (C1)",
  "description": "v1.0 definitions for identity, task packet, signed result, and agent record. A group is an agent.",
  "$defs": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "prefixedId": {
      "type": "string",
      "pattern": "^(agt|grp|pkt|res|nod)-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 5,
      "maxLength": 128
    },
    "kind": {
      "enum": ["human", "model", "group", "vm"]
    },
    "harness": {
      "enum": ["grok", "claude", "codex", "hermes", "prime", "human", "none"]
    },
    "loadClass": {
      "enum": ["structure-clear", "intention-critical", "ambiguous"]
    },
    "rigor": {
      "enum": ["vibe", "brief", "change", "architecture", "instrument"]
    },
    "permission": {
      "enum": ["read", "write", "sensitive"]
    },
    "disposition": {
      "enum": ["pass", "task-red", "baseline-red", "infra-red", "blocked", "parked"]
    },
    "topology": {
      "enum": [
        "solo",
        "weave",
        "pipeline",
        "fan-out",
        "fork",
        "review-pair",
        "human-gate",
        "conductor-workers",
        "quorum"
      ]
    },
    "acceptanceKind": {
      "enum": ["command", "journey", "contrast", "none"]
    },
    "signingMode": {
      "enum": ["stand-in", "key"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "harness", "signing"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "kind": { "$ref": "#/$defs/kind" },
        "display_name": { "type": "string", "minLength": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "signing": { "$ref": "#/$defs/signingOnIdentity" }
      }
    },
    "signingOnIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "$ref": "#/$defs/signingMode" },
        "stand_in_id": { "$ref": "#/$defs/kebabId" },
        "public_key": { "type": "string", "minLength": 1 },
        "algorithm": { "enum": ["ed25519"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "stand-in" } },
            "required": ["mode"]
          },
          "then": { "required": ["stand_in_id"] }
        },
        {
          "if": {
            "properties": { "mode": { "const": "key" } },
            "required": ["mode"]
          },
          "then": { "required": ["public_key", "algorithm"] }
        }
      ]
    },
    "signatureOnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "content_hash", "signed_at"],
      "properties": {
        "mode": { "$ref": "#/$defs/signingMode" },
        "stand_in_id": { "$ref": "#/$defs/kebabId" },
        "public_key": { "type": "string", "minLength": 1 },
        "algorithm": { "enum": ["ed25519"] },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signed_at": { "type": "string", "format": "date-time" },
        "bytes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "stand-in" } },
            "required": ["mode"]
          },
          "then": { "required": ["stand_in_id"] }
        },
        {
          "if": {
            "properties": { "mode": { "const": "key" } },
            "required": ["mode"]
          },
          "then": { "required": ["public_key", "algorithm", "bytes"] }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "invariant"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "invariant": { "type": "string", "minLength": 1 }
      }
    },
    "outOfScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "tracked_as"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "tracked_as": { "type": "string", "minLength": 1 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/acceptanceKind" },
        "command": { "type": "string", "minLength": 1 },
        "journey": { "type": "string", "minLength": 1 },
        "if_true": { "type": "string", "minLength": 1 },
        "if_false": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "command" } },
            "required": ["kind"]
          },
          "then": { "required": ["command"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "journey" } },
            "required": ["kind"]
          },
          "then": { "required": ["journey"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "contrast" } },
            "required": ["kind"]
          },
          "then": { "required": ["if_true", "if_false"] }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "paths", "do_not"],
      "properties": {
        "permission": { "$ref": "#/$defs/permission" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "do_not": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/acceptanceKind" },
        "command": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "output_tail": { "type": "string" },
        "journey": { "type": "string" },
        "if_true": { "type": "string" },
        "if_false": { "type": "string" },
        "observed": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "paths"],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "taskPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "node_id",
        "requester",
        "assignee",
        "goal",
        "anchors",
        "acceptance",
        "out_of_scope",
        "constraints",
        "load_class",
        "rigor"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/prefixedId" },
        "node_id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "change_id": { "type": "string", "minLength": 1 },
        "requester": { "$ref": "#/$defs/identity" },
        "assignee": { "$ref": "#/$defs/identity" },
        "goal": { "type": "string", "minLength": 1 },
        "non_goals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" }
        },
        "acceptance": { "$ref": "#/$defs/acceptance" },
        "out_of_scope": {
          "type": "array",
          "items": { "$ref": "#/$defs/outOfScope" }
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "load_class": { "$ref": "#/$defs/loadClass" },
        "rigor": { "$ref": "#/$defs/rigor" },
        "inherited": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "input_result_id": { "$ref": "#/$defs/prefixedId" },
        "role": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rigor": { "enum": ["change", "architecture", "instrument"] }
            },
            "required": ["rigor"]
          },
          "then": { "required": ["capability"] }
        }
      ]
    },
    "signedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "packet_id",
        "signer",
        "artifacts",
        "evidence",
        "disposition",
        "promoted",
        "commit",
        "summary",
        "signature"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/prefixedId" },
        "packet_id": { "$ref": "#/$defs/prefixedId" },
        "signer": { "$ref": "#/$defs/identity" },
        "topology": { "$ref": "#/$defs/topology" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" }
        },
        "member_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/prefixedId" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "promoted": { "type": "boolean" },
        "activation": { "type": "boolean" },
        "commit": {
          "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }]
        },
        "summary": { "type": "string", "minLength": 1 },
        "signature": { "$ref": "#/$defs/signatureOnResult" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "signer": {
                "properties": { "kind": { "const": "group" } },
                "required": ["kind"]
              }
            },
            "required": ["signer"]
          },
          "then": {
            "required": ["topology", "members", "member_results"]
          }
        }
      ]
    },
    "agentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity",
        "topology",
        "members",
        "reduce"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "identity": { "$ref": "#/$defs/identity" },
        "topology": { "$ref": "#/$defs/topology" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identity" }
        },
        "reduce": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
