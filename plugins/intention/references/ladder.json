{
  "schema_version": "1.0",
  "subscriptions": ["grok", "claude-code"],
  "notes": "Claude Code has the high usage limits. Codex Sol is named for when a second-family review is available; it is not subscribed today.",
  "human_override": "always wins",
  "max_inflight": 2,
  "routes": [
    {
      "id": "sonnet-5",
      "shapes": ["known", "mechanical", "bounded-edit"],
      "role": "worker",
      "harness": "claude",
      "interface": "sonnet-5",
      "surface": "skill-host",
      "density": "explicit",
      "effort": "low",
      "available": true
    },
    {
      "id": "opus-5",
      "shapes": ["implementation", "thinking"],
      "role": "worker",
      "harness": "claude",
      "interface": "opus-5",
      "surface": "skill-host",
      "density": "standard",
      "effort": "medium",
      "available": true
    },
    {
      "id": "opus-5-design",
      "shapes": ["design"],
      "role": "worker",
      "harness": "claude",
      "interface": "opus-5",
      "surface": "skill-host",
      "density": "standard",
      "effort": "low",
      "skills": ["designer"],
      "available": true,
      "notes": "Effort low or medium. Use Claude Code designer skills."
    },
    {
      "id": "fable-5.1-plan",
      "shapes": ["plan", "replan", "intend-consult"],
      "role": "consultant",
      "harness": "claude",
      "interface": "fable-5.1",
      "surface": "skill-host",
      "density": "lean",
      "effort": "high",
      "available": true,
      "notes": "Planning helper. Does not take the write."
    },
    {
      "id": "opus-5-fold",
      "shapes": ["fold"],
      "role": "folder",
      "harness": "claude",
      "interface": "opus-5",
      "surface": "skill-host",
      "density": "standard",
      "effort": "medium",
      "available": true,
      "notes": "Designated folder. Background fold, like advise. Human pick may send this to Grok instead."
    },
    {
      "id": "grok-fold",
      "shapes": ["fold"],
      "role": "folder",
      "harness": "grok",
      "interface": "grok-4.6",
      "surface": "skill-host",
      "density": "standard",
      "effort": "medium",
      "available": false,
      "notes": "Optional folder. Flip available to prefer Grok, or human-pick. Default is opus-5-fold."
    },
    {
      "id": "fable-5.1-arch-review",
      "shapes": ["architecture-review"],
      "role": "reader",
      "harness": "claude",
      "interface": "fable-5.1",
      "surface": "skill-host",
      "density": "lean",
      "effort": "high",
      "available": true,
      "required_on": ["architecture", "instrument"],
      "notes": "Default architecture buddy in Claude Code. ADR-005: a Claude author still cannot be the sole accepting reader — pick Grok for that."
    },
    {
      "id": "opus-4.8-arch-review",
      "shapes": ["architecture-review"],
      "role": "reader",
      "harness": "claude",
      "interface": "opus-4.8",
      "surface": "skill-host",
      "density": "lean",
      "effort": "high",
      "available": true,
      "notes": "Alternate Claude architecture reader. Not the assign() default (Fable 5.1 is first)."
    },
    {
      "id": "grok-arch-review",
      "shapes": ["architecture-review"],
      "role": "reader",
      "harness": "grok",
      "interface": "grok-4.6",
      "surface": "skill-host",
      "density": "lean",
      "effort": "high",
      "available": true,
      "notes": "Cross-family reader vs Claude authors. Not the assign() default (Fable 5.1 is first)."
    },
    {
      "id": "sol-arch-review",
      "shapes": ["architecture-review"],
      "role": "reader",
      "harness": "codex",
      "interface": "gpt-5.6-sol",
      "surface": "packet-only",
      "density": "lean",
      "effort": "high",
      "available": false,
      "notes": "Second-family reader. Prefer Codex CLI (`codex exec`, spawn --adapter codex). OpenAI HTTP API if no CLI but OPENAI_API_KEY is set. Packet-only. Never a slash."
    }
  ]
}
