    {
      "symbol": "openspec/changes/add-debrief-verb/specs/verbs/spec.md",
      "invariant": "finished or failed input; not durable truth; not a run wave"
    },
    {
      "symbol": "plugins/intention/skills/brief/SKILL.md",
      "invariant": "Opposite analog: brief compresses before; debrief expands after"
    }
  ],
  "acceptance": {
    "kind": "command",
    "command": "python3 plugins/intention/scripts/check-skills.py && python3 -c \"from pathlib import Path; s=Path('plugins/intention/skills/debrief/SKILL.md').read_text(); assert 'finished' in s.lower() and 'failed' in s.lower(); assert 'intend' in s.lower(); assert 'LEARNINGS' in s; print('ok')\"",
    "criteria": [
      "check-skills lists debrief",
      "SKILL names finished-or-failed and next intend",
      "symlink resolves"
    ]
  },
  "out_of_scope": [
    { "item": "default run wave", "tracked_as": "later" },
    { "item": "fold living specs", "tracked_as": "fold" },
    { "item": "skills add inside bazaar", "tracked_as": "none" }
  ],
  "constraints": {
    "permission": "write",
    "paths": [
