#!/bin/sh
# Refresh harness plugin caches when checking out main.
# git args: previous HEAD, new HEAD, 1 if branch checkout.
repo=$(git rev-parse --show-toplevel) || exit 0
branch=$(git rev-parse --abbrev-ref HEAD) || exit 0
[ "$3" = "1" ] || exit 0
[ "$branch" = "main" ] || exit 0
[ "${SYNC_HARNESS_PLUGINS:-1}" = "0" ] && exit 0
python3 "$repo/scripts/sync-harness-plugins.py" || echo "sync-harness-plugins: failed (git continues)"
exit 0
